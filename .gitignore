# Нативные проекты Capacitor коммитим (ios/ и android/), игнорим только артефакты сборки
*.tsbuildinfo
*.xcuserstate
xcuserdata/
ios/App/Pods/
ios/App/build/
ios/DerivedData/
android/build/
android/.gradle/
android/app/build/
android/local.properties

# Аудио, скачанное локально для офлайн-тестов (не в git — сотни мегабайт)
public/audio-offline/

# Capacitor: собранные веб-ассеты копируются в нативные проекты при
# `cap sync` — это артефакт сборки, в git ему не место (иначе каждый
# билд даёт 350 МБ дельты).
ios/App/App/public/
android/app/src/main/assets/public/
ios/App/App/capacitor.config.json
android/app/src/main/assets/capacitor.config.json

# Gradle/Kotlin служебный кэш нативного проекта
android/.kotlin/

# архив веб-сборки для заливки на хостинг — артефакт, не исходник
quranru-web.tar.gz

# Архивы Xcode — артефакт сборки, а не исходник: каждый .xcarchive весит
# больше 200 МБ и пересобирается из кода одной командой Archive. Скриншоты
# и контактные листы рядом (app-store/screenshots, app-store/previews) —
# наоборот, готовые материалы карточки, их коммитим.
app-store/archive/

# Ключи App Store Connect. Файл .p8 Apple даёт скачать один раз, он даёт
# право менять карточку приложения и отправлять сборки на ревью — в git ему
# не место ни при каких условиях. Отзывается в App Store Connect →
# Users and Access → Integrations одной кнопкой.
secrets/
*.p8

# Справочные материалы владельца, положенные в каталог проекта.
# Это не исходники: видео-образцы поведения, чужие сборки для сравнения.
# Однажды `git add -A` затянул сюда чужой APK на 140 МБ, и GitHub отклонил
# push — лимит на файл 100 МБ. Держим их вне репозитория, но на диске.
*.xapk
*.apk
*.ipa
*.mp4
*.mov

# Предпросмотр вариантов логотипа (scripts/brand/design-logo.py --preview)
brand-preview/
