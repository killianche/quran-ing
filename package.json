{
  "name": "quran-ing",
  "private": true,
  "version": "2.11.0",
  "iosBuild": 39,
  "type": "module",
  "scripts": {
    "brand:generate": "python3 scripts/generate-brand-assets.py",
    "dev": "vite",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' tsc -b && NODE_OPTIONS='--max-old-space-size=4096' vite build",
    "preview": "vite preview",
    "audio:split-luhaidan": "node --experimental-strip-types --no-warnings scripts/gen/split-luhaidan-ayahs.mjs",
    "audio:split-luhaidan:server": "python3 scripts/gen/split-luhaidan-ayahs.py",
    "check:sacred": "node scripts/check-sacred-text.mjs",
    "check:mushaf-pages": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs scripts/gen/build-mushaf-page-index.mjs",
    "check:ios-release": "node scripts/check-ios-release.mjs",
    "asc:status": "node scripts/appstore/asc-status.mjs",
    "asc:submit": "node scripts/appstore/asc-submit.mjs",
    "ios:release-check": "npm run check && npm run sync && npm run check:ios-release",
    "sync": "npm run build && npx cap sync",
    "test": "TZ=Europe/Moscow node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs scripts/test-audio-model.mjs",
    "check": "npm run test && npm run check:sacred && npm run check:mushaf-pages && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/device": "^8.0.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@sentry/react": "^10.54.0",
    "adhan": "^4.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.5"
  }
}
