<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Состояние сети — @capacitor/network: показать «нет интернета»
         вместо молчаливой ошибки, когда аят не скачан и стрим недоступен. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Фоновое воспроизведение.
         Bridge.onPause() у Capacitor НЕ приостанавливает WebView, поэтому
         <audio> в фоне не глушится, а navigator.mediaSession
         (lib/mediaSession.ts) поднимает системное медиа-уведомление силами
         WebView.

         Разрешения FOREGROUND_SERVICE / FOREGROUND_SERVICE_MEDIA_PLAYBACK
         сняты 2026-10-05 перед выкладкой в Google Play: самой службы в
         приложении нет, а за объявленный тип службы Play требует
         декларацию с видео её работы — пустая декларация ведёт к отказу.
         Если проверка на устройстве покажет, что Android обрывает долгое
         чтение с погашенным экраном, — нужна настоящая служба с
         MediaSession, и тогда разрешения возвращаются вместе с ней.
         На iOS сценарий закрыт ключом UIBackgroundModes=audio. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android 13+ требует явного разрешения, чтобы показать
         уведомление-плеер (и любые будущие напоминания о намазе). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Напоминания о намазе должны срабатывать в точную минуту, а не в
         ближайшее удобное системе окно. Android 12+ даёт это право отдельно. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
</manifest>
